{
	# El sitio va detrás de Cloudflare. Al confiar en sus rangos, X-Forwarded-For llega como
	# «IP del visitante, IP de Cloudflare» y la API (TRUST_PROXY=2) toma la primera.
	# Si quitas Cloudflare, borra este bloque y pon TRUST_PROXY=1.
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Sin registros de acceso: no guardamos URLs ni IPs innecesariamente.
	reverse_proxy web:3000 {
		# Durante un despliegue conviven dos contenedores `web` y luego se retira el viejo. Si la
		# conexión falla, se reintenta hasta 30 s en vez de responder 502 (ver deploy/desplegar.sh).
		lb_try_duration 30s
		lb_try_interval 250ms
	}
}
