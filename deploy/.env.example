# Variables de producción: /opt/acopiospanama/.env en el servidor (propiedad de `deploy`, modo 600).
# Nunca las subas a git.

# URL pública exacta, con https://, y el mismo dominio sin https:// para Caddy
APP_ORIGIN=https://acopiospanama.com
DOMAIN=acopiospanama.com

# Genera cada secreto con: openssl rand -hex 32 (la contraseña va dentro de una URL: sin símbolos)
POSTGRES_PASSWORD=
SECRET_KEY=

# Correo saliente (códigos de acceso, recordatorios). Ej.: smtps://usuario:clave@smtp.proveedor.com:465
# Si la contraseña tiene caracteres especiales, codifícalos (p. ej. @ → %40).
SMTP_URL=
MAIL_FROM=Acopio Panamá <no-responder@acopiospanama.com>

# Respaldos cifrados: genera el par EN TU COMPUTADORA con `age-keygen -o acopio-respaldos.key`
# y pega aquí solo la clave pública (age1…). Guarda el .key en tu gestor de contraseñas.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=14

# Correo a cuyo nombre quedan los centros de data/centros, que la API carga sola al desplegar.
# Sin él, la API no arranca si hay un lote pendiente (y el despliegue falla avisándolo).
CENTROS_EMAIL=

# Saltos de proxy delante de la API: Cloudflare + Caddy = 2. Sin Cloudflare, 1 (ver deploy/Caddyfile).
TRUST_PROXY=2

# Versión desplegada. El despliegue automático la fija al `sha-…` de cada commit;
# para volver atrás, pon aquí un sha anterior y ejecuta `docker compose up -d`.
IMAGE_TAG=latest

# Opcionales
# GHCR_OWNER=demogar            # dueño de las imágenes en ghcr.io
# MAP_TILE_HOST=https://tile.openstreetmap.org   # cambia a un proveedor propio si hay mucho tráfico
# ANALYTICS_HOST=https://stats.demogar.software  # analítica propia (Medama, sin cookies); ANALYTICS_HOST= la apaga
