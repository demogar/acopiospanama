# Desarrollo local. Copia a .env.development (no se sube a git).
NODE_ENV=development
PORT=3011
DATABASE_URL=postgresql://acopio:acopio@127.0.0.1:5432/acopio
APP_ORIGIN=http://localhost:3010
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdefghijklmnop
MAIL_MODE=outbox
ENABLE_DEV_OUTBOX=true
RELAX_RATE_LIMITS=true
COOKIE_SECURE=false
TRUST_PROXY=1
