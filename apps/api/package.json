{
  "name": "@acopio/api",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "migrate": "node dist/cli/cli.js migrate",
    "seed": "node dist/cli/seed.js",
    "cli": "node dist/cli/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "rm -rf .test-dist && tsc -p tsconfig.json --outDir .test-dist && node --test --test-concurrency=1 '.test-dist/test/*.test.js'"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "cookie-parser": "^1.4.7",
    "cron": "^4.4.0",
    "helmet": "^8.3.0",
    "kysely": "^0.29.6",
    "nodemailer": "^10.1.0",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "typescript": "5.9"
  }
}
